// ============================================
// FICHAS DE CUSTO DE AVIMENTOS
// ============================================

model FichaCusto {
  id               String           @id @default(uuid())
  orgId            String
  numeroSequencial Int              @unique // ID sequencial imutável
  referenciaPeca   String           @db.VarChar(100)
  nomePeca         String           @db.VarChar(255)
  categoria        String?          @db.VarChar(100)
  departmentId     String? // Departamento: Aviamentos e Insumos
  sectorId         String? // Setor: Fichas de Custo
  status           FichaCustoStatus @default(rascunho)

  // Dados da peça
  fotoPecaUrl        String? @db.VarChar(512) // URL do arquivo de foto
  fotoPecaStorageKey String? @db.VarChar(512) // Key no Object Storage

  // Valores calculados
  totalCustos    Decimal @default(0) @db.Decimal(15, 2)
  custoFinalPeca Decimal @default(0) @db.Decimal(15, 2)

  // Responsáveis (RACI)
  criadoPor             String // User ID
  aprovadoPor           String? // User ID
  reprovadoPor          String? // User ID
  responsavelFinanceiro String? // User ID

  // Datas importantes
  dataEnvioConferencia    DateTime?
  dataAprovacao           DateTime?
  dataReprovacao          DateTime?
  justificativaReprovacao String?   @db.Text

  // Versionamento
  versaoAtual Int @default(1)

  // Auditoria
  createdBy String
  updatedBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  // Relacionamentos
  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sector       Sector?               @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  insumos      InsumoFichaCusto[]
  boletos      BoletoFichaCusto[]
  versoes      VersaoFichaCusto[]
  auditorias   AuditoriaFichaCusto[]
  documentos   DocumentoFichaCusto[]

  @@unique([orgId, numeroSequencial])
  @@index([orgId, status])
  @@index([orgId, departmentId])
  @@index([orgId, sectorId])
  @@index([orgId, referenciaPeca])
  @@index([orgId, createdAt])
  @@index([orgId, deletedAt])
}

model InsumoFichaCusto {
  id           String @id @default(uuid())
  fichaCustoId String
  ordem        Int    @default(0) // Ordem de exibição

  // Dados do insumo
  descricao String     @db.VarChar(500)
  tipo      TipoInsumo @default(aviamento)

  // Fornecedor
  fornecedorId   String? // Relacionamento com Supplier (opcional)
  fornecedorNome String? @db.VarChar(255) // Nome do fornecedor (caso não tenha cadastro)
  fornecedorCnpj String? @db.VarChar(20)

  // Nota fiscal
  notaFiscalNumero String?   @db.VarChar(50)
  notaFiscalData   DateTime?
  notaFiscalValor  Decimal?  @db.Decimal(15, 2)

  // Quantidade e custo
  quantidade    Decimal @db.Decimal(15, 4)
  unidadeMedida String  @db.VarChar(20) // UN, KG, M, etc
  custoUnitario Decimal @db.Decimal(15, 4)
  custoTotal    Decimal @db.Decimal(15, 2) // Calculado: quantidade * custoUnitario

  // Observações
  observacoes String? @db.Text

  // Auditoria
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  fichaCusto FichaCusto @relation(fields: [fichaCustoId], references: [id], onDelete: Cascade)

  @@index([fichaCustoId])
  @@index([fornecedorId])
}

model BoletoFichaCusto {
  id           String  @id @default(uuid())
  fichaCustoId String
  insumoId     String? // Opcional: vinculado a um insumo específico

  // Dados do boleto
  arquivoUrl        String? @db.VarChar(512)
  arquivoStorageKey String? @db.VarChar(512)
  fornecedorId      String? // Relacionamento com Supplier
  fornecedorNome    String? @db.VarChar(255)

  // Valores
  valorBoleto    Decimal  @db.Decimal(15, 2)
  dataVencimento DateTime
  codigoBarras   String?  @db.VarChar(100)
  linhaDigitavel String?  @db.VarChar(100)

  // Status
  status        StatusBoleto @default(pendente)
  dataPagamento DateTime?

  // Observações
  observacoes String? @db.Text

  // Auditoria
  anexadoPor String // User ID
  pagoPor    String? // User ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relacionamentos
  fichaCusto FichaCusto @relation(fields: [fichaCustoId], references: [id], onDelete: Cascade)

  @@index([fichaCustoId])
  @@index([fornecedorId])
  @@index([status])
  @@index([dataVencimento])
}

model VersaoFichaCusto {
  id           String @id @default(uuid())
  fichaCustoId String
  versao       Int // Número da versão (1, 2, 3, ...)

  // Snapshot completo dos dados (JSON)
  dadosSnapshot Json // Estado completo da ficha naquele momento

  // Metadados
  criadoPor       String // User ID
  motivoAlteracao String?  @db.VarChar(500)
  createdAt       DateTime @default(now())

  // Relacionamentos
  fichaCusto FichaCusto @relation(fields: [fichaCustoId], references: [id], onDelete: Cascade)

  @@unique([fichaCustoId, versao])
  @@index([fichaCustoId])
  @@index([createdAt])
}

model AuditoriaFichaCusto {
  id           String @id @default(uuid())
  fichaCustoId String
  orgId        String

  // Dados da ação
  acao  String  @db.VarChar(100) // criar, atualizar, aprovar, reprovar, etc
  campo String? @db.VarChar(100) // Campo alterado (se aplicável)

  // Estados
  estadoAnterior Json? // Estado antes da alteração
  estadoNovo     Json? // Estado após a alteração

  // Contexto
  actorId   String // User ID
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  // Dados adicionais
  justificativa String? @db.Text
  metadata      Json? // Dados extras

  createdAt DateTime @default(now())

  // Relacionamentos
  fichaCusto   FichaCusto   @relation(fields: [fichaCustoId], references: [id], onDelete: Cascade)
  organization Organization @relation("FichaCustoAuditoria", fields: [orgId], references: [id], onDelete: Cascade)

  @@index([fichaCustoId])
  @@index([orgId])
  @@index([actorId])
  @@index([acao])
  @@index([createdAt])
}

model DocumentoFichaCusto {
  id                String        @id @default(uuid())
  fichaCustoId      String
  tipo              TipoDocumento
  nomeArquivo       String        @db.VarChar(255)
  arquivoUrl        String        @db.VarChar(512)
  arquivoStorageKey String        @db.VarChar(512)
  tamanhoBytes      BigInt
  mimeType          String        @db.VarChar(100)

  // Metadados
  descricao  String?  @db.VarChar(500)
  anexadoPor String // User ID
  createdAt  DateTime @default(now())

  // Relacionamentos
  fichaCusto FichaCusto @relation(fields: [fichaCustoId], references: [id], onDelete: Cascade)

  @@index([fichaCustoId])
  @@index([tipo])
  @@index([createdAt])
}

