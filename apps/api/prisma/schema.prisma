generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  rascunho
  aguardando_aprovacao
  ativo
  inativo
}

enum OrganizationRole {
  owner
  admin
  manager
  member
  viewer
}

enum UserStatus {
  pending
  active
  suspended
}

enum PrefichaStatus {
  rascunho
  pendente_aprovacao
  aprovado
  rejeitado
}

enum ClienteStatus {
  ativo
  inativo
  bloqueado
}

enum RepresentanteStatus {
  ativo
  inativo
  suspenso
}

enum ContratoStatus {
  rascunho
  pendente_assinatura
  vigente
  encerrado
  cancelado
}

enum ComissaoStatus {
  pendente
  calculada
  paga
  cancelada
}

enum DepartmentStatus {
  ativo
  inativo
  arquivado
}

enum SubdepartmentStatus {
  ativo
  inativo
  arquivado
}

enum SectorStatus {
  ativo
  inativo
  arquivado
}

enum PositionStatus {
  ativo
  inativo
  arquivado
}

enum FichaCustoStatus {
  rascunho
  enviada_para_conferencia
  aprovada
  reprovada
}

enum TipoInsumo {
  aviamento
  servico
  terceirizacao
  outros
}

enum TipoDocumento {
  foto_peca
  nota_fiscal
  boleto
  comprovante_pagamento
  outros
}

enum StatusBoleto {
  pendente
  pago
  cancelado
  vencido
}

enum PreFichaTecnicaStatus {
  rascunho
  submetida_para_revisao_tecnica
  em_revisao_ficha_tecnica
  aprovada_tecnicamente
  aguardando_aval_diretoria
  liberada_para_producao_piloto
  reprovada
}

enum TipoTecido {
  principal
  forro
  entretela
  outros
}

enum TipoInsumoTecnico {
  linha
  ziper
  botao
  etiqueta
  outros
}

enum UnidadeMedida {
  cm
  unidade
  metro
  kg
  litro
}

model Organization {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.VarChar(2048)

  // Registration Data
  legalName String?  @db.VarChar(255)
  cnpj      String?  @db.VarChar(20)
  address   String?  @db.VarChar(512)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  website   String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                 Product[]
  prefichas                Preficha[]
  settings                 CompanySettings?
  memberships              OrganizationMembership[]
  invites                  UserInvite[]
  auditLogs                OrganizationAuditLog[]
  suppliers                Supplier[]
  categories               Category[]
  clientes                 Cliente[]
  clienteTags              ClienteTag[]
  // clienteContacts          ClienteContact[] // TODO: Modelo não existe ainda
  representantes           Representante[]
  contratos                Contrato[]
  vendas                   Venda[]
  comissoes                Comissao[]
  departments              Department[]
  subdepartments           Subdepartment[]
  structureAuditLogs       OrganizationalStructureAuditLog[]
  departmentMemberships    DepartmentMembership[]            @relation("OrganizationDepartmentMemberships")
  subdepartmentMemberships SubdepartmentMembership[]         @relation("OrganizationSubdepartmentMemberships")
  sectorMemberships        SectorMembership[]                @relation("OrganizationSectorMemberships")
  positionMemberships      PositionMembership[]              @relation("OrganizationPositionMemberships")
  Sector                   Sector[]
  notifications            Notification[]                    @relation("Notifications")
  notificationPreferences  NotificationPreference[]          @relation("NotificationPreferences")
  Position                 Position[]
  positionPermissions      PositionPermission[]
  sectorPermissions        SectorPermission[]
  subdepartmentPermissions SubdepartmentPermission[]
  departmentPermissions    DepartmentPermission[]
  permissionAuditLogs      PermissionAuditLog[]
  permissionTemplates      PermissionTemplate[]
  userPermissions          UserPermission[]
  permissionChangeRequests PermissionChangeRequest[]

  // New Relations
  branches                     Branch[]
  roles                        Role[]
  segments                     TenantSegment[]
  fichasCusto                  FichaCusto[]
  statusCustomizadosFichaCusto StatusCustomizadoFichaCusto[] @relation("StatusCustomizadoFichaCusto")
  workflowPolicies             WorkflowPolicy[]
  approvals                    Approval[]
  // accessAuditLogs              AccessAuditLog[] @relation("AccessAuditLogs") // TODO: Modelo não existe ainda

  // Fichas de Custo
  fichasCustoAuditorias AuditoriaFichaCusto[] @relation("FichaCustoAuditoria")
  suppliersAuditorias   AuditoriaSupplier[]   @relation("SupplierAuditoria")
  notasSupplier         NotaSupplier[]

  // Pré-Fichas Técnicas
  preFichasTecnicas           PreFichaTecnica[]
  preFichasTecnicasAuditorias AuditoriaPreFichaTecnica[] @relation("PreFichaTecnicaAuditoria")

  // Fornecedores - Extensões
  supplierTags    SupplierTag[]
  supplierAlertas AlertaSupplier[]

  // Company Settings Audit
  companySettingsAuditLogs CompanySettingsAuditLog[] @relation("CompanySettingsAuditLog")

  // Governance
  approvalWorkflows       ApprovalWorkflow[]
  approvalRequests        ApprovalRequest[]
  companySettingsVersions CompanySettingsVersion[]

  // Integrations
  apiKeys                ApiKey[]
  webhookEndpoints       WebhookEndpoint[]
  integrationConnections IntegrationConnection[]

  // Analytics
  systemMetrics SystemMetric[]
  usageLogs     UsageLog[]

  // Business Analytics
  salesMetrics     SalesMetric[]
  inventoryMetrics InventoryMetric[]
  customerMetrics  CustomerMetric[]
  supplierMetrics  SupplierMetric[]
  productMetrics   ProductMetric[]
  activityLogs     ActivityLog[]

  // Advanced Security
  securityPolicies   SecurityPolicy[]
  timeWindows        TimeWindow[]
  acls               AccessControlList[]
  accessDecisionLogs AccessDecisionLog[]

  // Certificações
  certifications OrganizationCertification[] @relation("OrganizationCertifications")
  GeoRestriction GeoRestriction[]
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  displayName  String?
  avatarUrl    String?    @db.VarChar(2048)
  passwordHash String?
  status       UserStatus @default(pending)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  aiUsageLogs AiUsageLog[]
  usageLogs   UsageLog[]

  // Personal Information Fields
  cpf           String?   @db.Text // CPF formatado (000.000.000-00)
  phone         String?   @db.Text // Telefone formatado
  birthDate     DateTime? // Data de nascimento
  admissionDate DateTime? // Data de admissão
  observations  String?   @db.Text // Observações sobre o usuário

  // 2FA Fields
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   @db.VarChar(255)
  twoFactorBackupCodes String?   @db.Text // JSON array de códigos de backup
  twoFactorEnabledAt   DateTime?

  // Security Fields
  blockedUntil DateTime? // Bloqueio temporário por IDS
  lastLoginIp  String?   @db.VarChar(45) // Último IP de login

  // Organizational Fields
  branchId   String?
  positionId String?

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  memberships              OrganizationMembership[]
  invitesAuthored          UserInvite[]              @relation("InviteAuthor")
  acceptedInvites          UserInvite[]              @relation("AcceptedUser")
  departmentMemberships    DepartmentMembership[]    @relation("UserDepartmentMemberships")
  subdepartmentMemberships SubdepartmentMembership[] @relation("UserSubdepartmentMemberships")
  sectorMemberships        SectorMembership[]        @relation("UserSectorMemberships")
  positionMemberships      PositionMembership[]      @relation("UserPositionMemberships")
  roles                    UserRole[]
  userPermissions          UserPermission[]

  // Notificações
  notifications           Notification[]           @relation("UserNotifications")
  notificationPreferences NotificationPreference[] @relation("UserNotificationPreferences")

  // Dispositivos Confiáveis
  trustedDevices TrustedDevice[] @relation("UserTrustedDevices")

  // Tokens de API (definido após User)
  apiTokens ApiToken[] @relation("UserApiTokens")

  // Refresh Tokens
  refreshTokens RefreshToken[] @relation("UserRefreshTokens")

  // Governance
  approvalRequests        ApprovalRequest[]
  approvalRequestComments ApprovalRequestComment[]
  createdCompanyVersions  CompanySettingsVersion[]

  // Security
  mustChangePassword  Boolean              @default(false)
  tokenVersion        Int                  @default(1) // Para revogação de sessões (Kill Switch)
  passwordResetTokens PasswordResetToken[]
  securityAlerts      SecurityAlert[]      @relation("UserSecurityAlerts")
  authenticators      Authenticator[] // WebAuthn/Passkeys

  // Advanced Security
  acls              AccessControlList[]
  geoRestrictions   UserGeoRestriction[]
  behavioralProfile UserBehavioralProfile?
  sessions          UserSession[]

  @@index([cpf])
}


model Authenticator {

  id                   String   @id @default(uuid())
  credentialID         String   @unique
  userId               String
  credentialPublicKey  String   @db.Text
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(member)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model UserInvite {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           OrganizationRole @default(member)
  token          String           @unique
  invitedById    String
  acceptedUserId String?
  status         String           @default("pending")
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteAuthor", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedUser User?        @relation("AcceptedUser", fields: [acceptedUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email], name: "unique_invite_per_org_email")
  @@index([organizationId])
}

model Product {
  id          String        @id @default(uuid())
  orgId       String
  name        String
  description String?       @db.VarChar(1024)
  sku         String?       @db.VarChar(100)
  status      ProductStatus @default(rascunho)
  categoryId  String?
  createdBy   String
  updatedBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category     Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  auditLogs    ProductAuditLog[]
  prefichas    Preficha[]
  variants     ProductVariant[]

  @@unique([orgId, name])
  @@unique([orgId, sku], name: "unique_sku_per_org")
  @@index([orgId, status])
  @@index([orgId, sku])
  @@index([categoryId])
}

model ProductAuditLog {
  id        String   @id @default(uuid())
  productId String
  orgId     String
  action    String
  actorId   String
  payload   Json?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([orgId, createdAt])
}

model OrganizationAuditLog {
  id        String   @id @default(uuid())
  orgId     String
  action    String
  actorId   String
  targetId  String?
  payload   Json?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model CompanySettings {
  id             String   @id @default(uuid())
  orgId          String   @unique
  logoUrl        String?
  primaryColor   String?  @db.VarChar(16)
  secondaryColor String?  @db.VarChar(16)
  themeMode      String?  @db.VarChar(10)
  videoLink      String?  @db.VarChar(2048)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Audit log for Company Settings changes
model CompanySettingsAuditLog {
  id    String @id @default(uuid())
  orgId String

  // Action and Context
  action String @db.VarChar(100) // create, update, delete, restore
  entity String @db.VarChar(100) // company_settings, branch, etc

  // Changed field
  fieldName  String? @db.VarChar(100) // "razaoSocial", "cnpj", etc
  fieldLabel String? @db.VarChar(255) // "Razão Social", "CNPJ"

  // States
  oldValue Json? // Previous value (can be complex object)
  newValue Json? // New value

  // Metadata
  actorId   String // ID of user who made the change
  actorName String? @db.VarChar(255) // User name (cached)

  // Security
  ipAddress String? @db.VarChar(45) // IPv4 or IPv6
  userAgent String? @db.VarChar(500) // Browser info

  // Additional data
  justification String? @db.Text // Reason for change (optional)
  metadata      Json? // Extra data

  createdAt DateTime @default(now())

  // Relationships
  organization Organization @relation("CompanySettingsAuditLog", fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([actorId])
  @@index([entity])
  @@index([fieldName])
  @@index([action])
}

model CompanySettingsVersion {
  id      String @id @default(uuid())
  orgId   String
  version Int

  // Snapshot data
  snapshot Json // Full copy of settings
  name     String? @db.VarChar(255) // Optional name (e.g. "Backup Pre-Audit")

  // Metadata
  createdBy String
  createdAt DateTime @default(now())

  restoredAt DateTime? // If this version was restored later

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@unique([orgId, version])
  @@index([orgId, createdAt])
}

model Preficha {
  id        String         @id @default(uuid())
  orgId     String
  produtoId String
  status    PrefichaStatus @default(rascunho)
  createdBy String
  updatedBy String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  aprovadores  PrefichaAprovador[]
  comentarios  PrefichaComentario[]
  auditLogs    PrefichaAuditLog[]

  @@unique([orgId, produtoId], name: "unique_preficha_per_product")
  @@index([orgId, status])
  @@index([produtoId])
}

model PrefichaAprovador {
  id         String    @id @default(uuid())
  prefichaId String
  userId     String
  aprovado   Boolean   @default(false)
  aprovadoEm DateTime?
  comentario String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  preficha Preficha @relation(fields: [prefichaId], references: [id], onDelete: Cascade)

  @@unique([prefichaId, userId], name: "prefichaId_userId")
  @@index([prefichaId])
  @@index([userId])
}

model PrefichaComentario {
  id         String   @id @default(uuid())
  prefichaId String
  userId     String
  comentario String   @db.VarChar(1024)
  createdAt  DateTime @default(now())

  preficha Preficha @relation(fields: [prefichaId], references: [id], onDelete: Cascade)

  @@index([prefichaId, createdAt])
}

model PrefichaAuditLog {
  id         String   @id @default(uuid())
  prefichaId String
  orgId      String
  action     String
  actorId    String
  payload    Json?
  createdAt  DateTime @default(now())

  preficha Preficha @relation(fields: [prefichaId], references: [id], onDelete: Cascade)

  @@index([prefichaId, createdAt])
  @@index([orgId, createdAt])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  orgId     String
  sku       String   @db.VarChar(100)
  nome      String   @db.VarChar(180)
  atributos Json // { tamanho: 'M', cor: 'azul', material: 'algodão' }
  preco     Decimal? @db.Decimal(10, 2)
  estoque   Int?     @default(0)
  ativo     Boolean  @default(true)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orgId, sku], name: "unique_variant_sku_per_org")
  @@index([productId])
  @@index([orgId, sku])
  @@index([orgId, ativo])
}

model Category {
  id          String   @id @default(uuid())
  orgId       String
  name        String
  slug        String
  description String?  @db.VarChar(512)
  parentId    String?
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([orgId, slug], name: "unique_category_slug_per_org")
  @@index([orgId, parentId])
  @@index([orgId, ativo])
  @@index([parentId])
}

model Supplier {
  id        String    @id @default(uuid())
  orgId     String
  name      String
  email     String?
  phone     String?   @db.Text
  document  String?   @db.Text
  address   String?   @db.VarChar(512)
  city      String?   @db.VarChar(100)
  state     String?   @db.VarChar(2)
  zipCode   String?   @db.VarChar(10)
  status    String    @default("ativo")
  notes     String?   @db.VarChar(1024)
  createdBy String
  updatedBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
  deletedBy String? // User ID que deletou

  // Campos adicionais
  website           String?   @db.VarChar(255)
  contatoPrincipal  String?   @db.VarChar(255)
  cargoContato      String?   @db.VarChar(100)
  ramoAtividade     String?   @db.VarChar(255)
  tipoFornecedor    String?   @db.VarChar(100)
  prazoPagamento    Int? // Dias
  condicaoPagamento String?   @db.VarChar(255)
  limiteCredito     Decimal?  @db.Decimal(15, 2)
  avaliacao         Decimal?  @db.Decimal(3, 2) // 0.00 a 5.00
  dataUltimaCompra  DateTime?
  totalCompras      Decimal?  @db.Decimal(15, 2)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Relacionamentos
  auditorias      AuditoriaSupplier[]
  versoes         VersaoSupplier[]
  documentos      DocumentoSupplier[]
  tagRelations    SupplierTagRelation[]
  avaliacoes      AvaliacaoSupplier[]
  historicoPrecos HistoricoPrecoSupplier[]
  alertas         AlertaSupplier[]
  contatos        SupplierContact[]
  notas           NotaSupplier[]

  @@unique([orgId, name])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@index([deletedAt])
  @@index([orgId, tipoFornecedor])
  @@index([orgId, ramoAtividade])
  @@index([dataUltimaCompra])
}

model VersaoSupplier {
  id         String @id @default(uuid())
  supplierId String
  versao     Int // Número da versão (1, 2, 3, ...)

  // Snapshot completo dos dados (JSON)
  dadosSnapshot Json // Estado completo do fornecedor naquele momento

  // Metadados
  criadoPor       String // User ID
  motivoAlteracao String?  @db.VarChar(500)
  createdAt       DateTime @default(now())

  // Relacionamentos
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, versao])
  @@index([supplierId])
  @@index([createdAt])
}

model AuditoriaSupplier {
  id         String @id @default(uuid())
  supplierId String
  orgId      String

  // Dados da ação
  acao  String  @db.VarChar(100) // criar, atualizar, deletar, restaurar, etc
  campo String? @db.VarChar(100) // Campo alterado (se aplicável)

  // Estados
  estadoAnterior Json? // Estado antes da alteração
  estadoNovo     Json? // Estado após a alteração

  // Contexto
  actorId   String // User ID
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)

  // Dados adicionais
  justificativa String? @db.Text
  metadata      Json? // Dados extras

  createdAt DateTime @default(now())

  // Relacionamentos
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  organization Organization @relation("SupplierAuditoria", fields: [orgId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([orgId])
  @@index([actorId])
  @@index([acao])
  @@index([createdAt])
}

model DocumentoSupplier {
  id                String        @id @default(uuid())
  supplierId        String
  tipo              TipoDocumento
  nomeArquivo       String        @db.VarChar(255)
  arquivoUrl        String        @db.VarChar(512)
  arquivoStorageKey String        @db.VarChar(512)
  tamanhoBytes      BigInt
  mimeType          String        @db.VarChar(100)

  // Metadados
  descricao  String?  @db.VarChar(500)
  anexadoPor String // User ID
  createdAt  DateTime @default(now())

  // Relacionamentos
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([tipo])
  @@index([createdAt])
}

// Contatos do Fornecedor
model SupplierContact {
  id          String   @id @default(uuid())
  supplierId  String
  name        String   @db.VarChar(255)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  cargo       String?  @db.VarChar(100)
  isPrincipal Boolean  @default(false)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([supplierId, isPrincipal])
  @@index([isPrincipal])
}

// Tags/Categorias para Fornecedores
model SupplierTag {
  id        String   @id @default(uuid())
  orgId     String
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(7) // Hex color
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  suppliers    SupplierTagRelation[]

  @@unique([orgId, name])
  @@index([orgId])
}

model SupplierTagRelation {
  id         String   @id @default(uuid())
  supplierId String
  tagId      String
  createdAt  DateTime @default(now())

  supplier Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tag      SupplierTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([supplierId, tagId])
  @@index([supplierId])
  @@index([tagId])
}

// Avaliações de Fornecedores
model AvaliacaoSupplier {
  id         String   @id @default(uuid())
  supplierId String
  userId     String // User que avaliou
  nota       Int // 1 a 5
  comentario String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, userId]) // Um usuário só pode avaliar uma vez
  @@index([supplierId])
  @@index([userId])
  @@index([nota])
}

// Histórico de Preços
model HistoricoPrecoSupplier {
  id           String   @id @default(uuid())
  supplierId   String
  insumoId     String? // ID do insumo (se aplicável)
  insumoNome   String   @db.VarChar(255) // Nome do insumo
  preco        Decimal  @db.Decimal(10, 2)
  quantidade   Decimal? @db.Decimal(10, 2)
  unidade      String?  @db.VarChar(20)
  fichaCustoId String? // ID da ficha de custo relacionada
  dataCompra   DateTime
  createdAt    DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([insumoId])
  @@index([dataCompra])
  @@index([fichaCustoId])
}

// Alertas e Notificações
model AlertaSupplier {
  id             String             @id @default(uuid())
  supplierId     String?
  orgId          String
  tipo           TipoAlertaSupplier
  titulo         String             @db.VarChar(255)
  mensagem       String             @db.Text
  prioridade     PrioridadeAlerta   @default(media)
  status         StatusAlerta       @default(pendente)
  dataVencimento DateTime? // Para alertas de vencimento
  lido           Boolean            @default(false)
  lidoEm         DateTime?
  lidoPor        String? // User ID
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([orgId])
  @@index([tipo])
  @@index([status])
  @@index([dataVencimento])
  @@index([lido])
}

enum TipoAlertaSupplier {
  documento_vencendo
  documento_vencido
  fornecedor_inativo
  variacao_preco
  novo_fornecedor
  sem_compras_recentes
  avaliacao_baixa
  customizado
}

enum PrioridadeAlerta {
  baixa
  media
  alta
  critica
}

enum StatusAlerta {
  pendente
  resolvido
  ignorado
}

// Notas Internas do Fornecedor
model NotaSupplier {
  id         String   @id @default(uuid())
  supplierId String
  orgId      String
  titulo     String?  @db.VarChar(255)
  conteudo   String   @db.Text
  tipo       String   @default("nota") @db.VarChar(50) // nota, lembrete, observacao
  criadoPor  String // User ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([orgId])
  @@index([supplierId, tipo])
  @@index([criadoPor])
  @@index([createdAt])
}

model Cliente {
  id                 String        @id @default(uuid())
  orgId              String
  nome               String
  nomeSocial         String?       @db.VarChar(255) // Nome Social / Apelido
  razaoSocial        String?       @db.VarChar(255)
  nomeFantasia       String?       @db.VarChar(255) // Nome Fantasia separado (especialmente para PJ)
  tipo               String        @default("fisica") // fisica, juridica
  documento          String        @db.Text // CPF ou CNPJ
  rg                 String?       @db.Text // RG para PF
  orgaoEmissor       String?       @db.VarChar(10) // Órgão Emissor do RG (SSP, IFP, etc)
  dataNascimento     DateTime? // Data de Nascimento (PF) / Data de Fundação (PJ)
  sexo               String?       @db.VarChar(20) // Sexo/Gênero (PF): masculino, feminino, outro, nao_informar
  estadoCivil        String?       @db.VarChar(20) // Estado Civil (PF): solteiro, casado, divorciado, viuvo, uniao_estavel
  nacionalidade      String?       @db.VarChar(100) // Nacionalidade
  naturalidadeCidade String?       @db.VarChar(100) // Cidade de Naturalidade
  naturalidadeEstado String?       @db.VarChar(2) // Estado de Naturalidade (UF)
  tituloEleitor      String?       @db.VarChar(20) // Título de Eleitor
  certidaoNascimento String?       @db.VarChar(50) // Certidão de Nascimento
  certidaoCasamento  String?       @db.VarChar(50) // Certidão de Casamento
  nomeMae            String?       @db.VarChar(255) // Nome da Mãe (PF)
  nomePai            String?       @db.VarChar(255) // Nome do Pai (PF)
  inscricaoEstadual  String?       @db.VarChar(50) // IE para PJ
  inscricaoMunicipal String?       @db.VarChar(50) // IM para PJ
  email              String?       @db.VarChar(255)
  telefone           String?       @db.Text
  celular            String?       @db.Text
  website            String?       @db.VarChar(512) // Website do cliente
  endereco           String?       @db.VarChar(512) // Logradouro
  numero             String?       @db.VarChar(20) // Número do endereço
  complemento        String?       @db.VarChar(255) // Complemento do endereço
  bairro             String?       @db.VarChar(100) // Bairro
  cidade             String?       @db.VarChar(100)
  estado             String?       @db.VarChar(2)
  cep                String?       @db.VarChar(10)
  status             ClienteStatus @default(ativo)
  observacoes        String?       @db.VarChar(2048)
  createdBy          String
  updatedBy          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization  Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  representante Representante?
  vendas        Venda[]
  comissoes     Comissao[]
  tags          ClienteTagRelation[]
  // contatos      ClienteContact[] // TODO: Modelo não existe ainda

  @@unique([orgId, documento], name: "unique_cliente_documento")
  @@index([orgId, status])
  @@index([orgId, nome])
}

// Tags/Categorias para Clientes
model ClienteTag {
  id        String   @id @default(uuid())
  orgId     String
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(7) // Hex color
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientes     ClienteTagRelation[]

  @@unique([orgId, name])
  @@index([orgId])
}

model ClienteTagRelation {
  id        String   @id @default(uuid())
  clienteId String
  tagId     String
  createdAt DateTime @default(now())

  cliente Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tag     ClienteTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tagId])
  @@index([clienteId])
  @@index([tagId])
}

model Representante {
  id                 String              @id @default(uuid())
  orgId              String
  clienteId          String              @unique
  nome               String
  documento          String              @db.VarChar(20)
  email              String?             @db.VarChar(255)
  telefone           String?             @db.VarChar(20)
  celular            String?             @db.VarChar(20)
  endereco           String?             @db.VarChar(512)
  cidade             String?             @db.VarChar(100)
  estado             String?             @db.VarChar(2)
  cep                String?             @db.VarChar(10)
  percentualComissao Decimal             @db.Decimal(5, 2) // Ex: 5.50 = 5.5%
  status             RepresentanteStatus @default(ativo)
  observacoes        String?             @db.VarChar(2048)
  createdBy          String
  updatedBy          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  contratos    Contrato[]
  comissoes    Comissao[]

  @@index([orgId, status])
  @@index([clienteId])
}

model Contrato {
  id                 String         @id @default(uuid())
  orgId              String
  representanteId    String
  numero             String         @db.VarChar(50)
  dataInicio         DateTime
  dataFim            DateTime?
  percentualComissao Decimal        @db.Decimal(5, 2)
  valorMinimo        Decimal?       @db.Decimal(12, 2)
  valorMaximo        Decimal?       @db.Decimal(12, 2)
  termos             String?        @db.Text
  status             ContratoStatus @default(rascunho)
  assinadoEm         DateTime?
  assinadoPor        String?
  encerradoEm        DateTime?
  observacoes        String?        @db.VarChar(2048)
  createdBy          String
  updatedBy          String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  representante Representante @relation(fields: [representanteId], references: [id], onDelete: Cascade)

  @@unique([orgId, numero], name: "unique_contrato_numero")
  @@index([orgId, representanteId])
  @@index([orgId, status])
  @@index([representanteId, status])
}

model Venda {
  id                  String    @id @default(uuid())
  orgId               String
  clienteId           String
  numeroPedido        String    @db.VarChar(100)
  numeroNotaFiscal    String?   @db.VarChar(100)
  dataVenda           DateTime
  dataPagamento       DateTime?
  valorTotal          Decimal   @db.Decimal(12, 2)
  valorComissao       Decimal   @db.Decimal(12, 2)
  status              String    @default("pendente") // pendente, confirmada, cancelada
  observacoes         String?   @db.VarChar(1024)
  // Campos de sincronização com e-millennium
  emillenniumPedidoId String?   @db.VarChar(100)
  emillenniumSyncAt   DateTime?
  createdBy           String
  updatedBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cliente      Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  comissoes    Comissao[]

  @@unique([orgId, numeroPedido], name: "unique_venda_numero_pedido")
  @@index([orgId, clienteId])
  @@index([orgId, dataVenda])
  @@index([clienteId, dataVenda])
  @@index([emillenniumPedidoId])
}

model Comissao {
  id                   String         @id @default(uuid())
  orgId                String
  representanteId      String
  clienteId            String
  vendaId              String
  valorComissao        Decimal        @db.Decimal(12, 2)
  percentualAplicado   Decimal        @db.Decimal(5, 2)
  dataVenda            DateTime
  dataCalculo          DateTime       @default(now())
  dataPagamento        DateTime?
  status               ComissaoStatus @default(pendente)
  observacoes          String?        @db.VarChar(1024)
  // Rastreamento de assinatura
  assinadoEm           DateTime?
  assinadoPor          String?
  // Campos de pagamento
  numeroPagamento      String?        @db.VarChar(100)
  comprovantePagamento String?        @db.VarChar(512)
  createdBy            String
  updatedBy            String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  representante Representante @relation(fields: [representanteId], references: [id], onDelete: Cascade)
  cliente       Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  venda         Venda         @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([orgId, representanteId, status])
  @@index([orgId, status])
  @@index([representanteId, status])
  @@index([vendaId])
  @@index([dataVenda])
}

// Estrutura Organizacional Correta (conforme docs/estrutura-organizacional.md)
// Hierarquia: Empresa → Departamento → Subdepartamento → Setor → Cargo

model Department {
  id          String           @id @default(uuid())
  orgId       String
  branchId    String? // Optional: department can be specific to a branch
  name        String
  code        String           @db.VarChar(50) // Código único (ex: "DPT-001")
  description String?          @db.VarChar(1024)
  parentId    String? // Hierarquia: departamentos podem ter departamentos pai (subdivisões)
  status      DepartmentStatus @default(ativo)
  ordem       Int              @default(0)
  metadata    Json? // Dados adicionais flexíveis
  createdBy   String
  updatedBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  organization   Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parent         Department?            @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Department[]           @relation("DepartmentHierarchy")
  subdepartments Subdepartment[] // Subdepartamentos pertencem a departamentos
  sectors        Sector[] // Setores podem pertencer diretamente a departamentos (retrocompatibilidade)
  memberships    DepartmentMembership[]
  permissions    DepartmentPermission[]
  fichasCusto    FichaCusto[] // Fichas de custo vinculadas ao departamento

  @@unique([orgId, code], name: "unique_department_code_per_org")
  @@index([orgId, parentId])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@index([parentId])
}

model Subdepartment {
  id           String              @id @default(uuid())
  orgId        String
  branchId     String? // Optional: subdepartment can be specific to a branch
  departmentId String // Subdepartamento pertence a um departamento
  name         String
  code         String              @db.VarChar(50) // Código único (ex: "SDPT-001")
  description  String?             @db.VarChar(1024)
  parentId     String? // Hierarquia: subdepartamentos podem ter subdepartamentos pai
  status       SubdepartmentStatus @default(ativo)
  ordem        Int                 @default(0)
  metadata     Json? // Dados adicionais flexíveis
  createdBy    String
  updatedBy    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  organization Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch       Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department   Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  parent       Subdepartment?            @relation("SubdepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Subdepartment[]           @relation("SubdepartmentHierarchy")
  sectors      Sector[] // Setores pertencem a subdepartamentos
  memberships  SubdepartmentMembership[]
  permissions  SubdepartmentPermission[]

  @@unique([orgId, code], name: "unique_subdepartment_code_per_org")
  @@index([orgId, departmentId])
  @@index([orgId, parentId])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@index([departmentId])
  @@index([parentId])
}

model Sector {
  id              String       @id @default(uuid())
  orgId           String
  branchId        String? // Optional: sector can be specific to a branch
  departmentId    String // Setor pertence a um departamento (retrocompatibilidade)
  subdepartmentId String? // Setor pertence a um subdepartamento (preferencial)
  name            String
  code            String       @db.VarChar(50) // Código único (ex: "SEC-001")
  description     String?      @db.VarChar(1024)
  parentId        String? // Hierarquia: setores podem ter setores pai
  status          SectorStatus @default(ativo)
  ordem           Int          @default(0)
  metadata        Json? // Dados adicionais flexíveis
  createdBy       String
  updatedBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  organization  Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch        Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department    Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  subdepartment Subdepartment?     @relation(fields: [subdepartmentId], references: [id], onDelete: Cascade)
  parent        Sector?            @relation("SectorHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Sector[]           @relation("SectorHierarchy")
  positions     Position[]
  memberships   SectorMembership[]
  permissions   SectorPermission[]
  fichasCusto   FichaCusto[]

  @@unique([orgId, code], name: "unique_sector_code_per_org")
  @@index([orgId, departmentId])
  @@index([orgId, subdepartmentId])
  @@index([orgId, parentId])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@index([departmentId])
  @@index([subdepartmentId])
  @@index([parentId])
}

model Position {
  id                String         @id @default(uuid())
  orgId             String
  sectorId          String // Cargo pertence a um setor
  name              String // Nome do cargo (ex: "Gerente de Vendas", "Analista de Marketing")
  code              String         @db.VarChar(50) // Código único (ex: "POS-001")
  description       String?        @db.VarChar(1024)
  responsabilidades String?        @db.Text // Responsabilidades do cargo
  requisitos        String?        @db.Text // Requisitos para ocupar o cargo
  salarioMin        Decimal?       @db.Decimal(12, 2)
  salarioMax        Decimal?       @db.Decimal(12, 2)
  status            PositionStatus @default(ativo)
  ordem             Int            @default(0)
  metadata          Json? // Dados adicionais flexíveis
  createdBy         String
  updatedBy         String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  deletedBy         String?

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sector       Sector               @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  users        User[]
  memberships  PositionMembership[]
  permissions  PositionPermission[]

  @@unique([orgId, code], name: "unique_position_code_per_org")
  @@index([orgId, sectorId])
  @@index([orgId, status])
  @@index([orgId, deletedAt])
  @@index([sectorId])
}

// Membros da estrutura organizacional

model DepartmentMembership {
  id           String           @id @default(uuid())
  orgId        String
  departmentId String
  userId       String
  role         OrganizationRole @default(member) // Papel no departamento
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  organization Organization @relation("OrganizationDepartmentMemberships", fields: [orgId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User         @relation("UserDepartmentMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId], name: "unique_department_membership")
  @@index([orgId, departmentId])
  @@index([userId])
}

model SubdepartmentMembership {
  id              String           @id @default(uuid())
  orgId           String
  subdepartmentId String
  userId          String
  role            OrganizationRole @default(member) // Papel no subdepartamento
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization  Organization  @relation("OrganizationSubdepartmentMemberships", fields: [orgId], references: [id], onDelete: Cascade)
  subdepartment Subdepartment @relation(fields: [subdepartmentId], references: [id], onDelete: Cascade)
  user          User          @relation("UserSubdepartmentMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([subdepartmentId, userId], name: "unique_subdepartment_membership")
  @@index([orgId, subdepartmentId])
  @@index([userId])
}

model SectorMembership {
  id        String           @id @default(uuid())
  orgId     String
  sectorId  String
  userId    String
  role      OrganizationRole @default(member) // Papel no setor
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  organization Organization @relation("OrganizationSectorMemberships", fields: [orgId], references: [id], onDelete: Cascade)
  sector       Sector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  user         User         @relation("UserSectorMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sectorId, userId], name: "unique_sector_membership")
  @@index([orgId, sectorId])
  @@index([userId])
}

model PositionMembership {
  id         String           @id @default(uuid())
  orgId      String
  positionId String
  userId     String
  role       OrganizationRole @default(member) // Papel no cargo
  dataInicio DateTime? // Data de início no cargo
  dataFim    DateTime? // Data de término no cargo (se houver)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  organization Organization @relation("OrganizationPositionMemberships", fields: [orgId], references: [id], onDelete: Cascade)
  position     Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user         User         @relation("UserPositionMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId], name: "unique_position_membership")
  @@index([orgId, positionId])
  @@index([userId])
  @@index([dataInicio])
  @@index([dataFim])
}

// Audit logs para estrutura organizacional

model OrganizationalStructureAuditLog {
  id         String   @id @default(uuid())
  orgId      String
  entityType String // "department" | "subdepartment" | "sector" | "position"
  entityId   String
  action     String // "created" | "updated" | "deleted" | "member_added" | "member_removed"
  actorId    String
  payload    Json?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
  @@index([entityType, entityId])
}

// Permissões por cargo (Matriz de Permissões RBAC)
model PositionPermission {
  id           String   @id @default(uuid())
  orgId        String
  positionId   String
  permissionId String // Referência à permissão
  granted      Boolean  @default(true) // true = permitido, false = negado explícito
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  position     Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, permissionId], name: "unique_position_permission")
  @@index([orgId, positionId])
  @@index([positionId])
  @@index([permissionId])
}

// Permissões por setor (Matriz de Permissões RBAC)
model SectorPermission {
  id           String   @id @default(uuid())
  orgId        String
  sectorId     String
  permissionId String // Referência à permissão
  granted      Boolean  @default(true) // true = permitido, false = negado explícito
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sector       Sector       @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@unique([sectorId, permissionId], name: "unique_sector_permission")
  @@index([orgId, sectorId])
  @@index([sectorId])
  @@index([permissionId])
}

// Permissões por subdepartamento (Matriz de Permissões RBAC)
model SubdepartmentPermission {
  id              String   @id @default(uuid())
  orgId           String
  subdepartmentId String
  permissionId    String // Referência à permissão
  granted         Boolean  @default(true) // true = permitido, false = negado explícito
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String
  updatedBy       String

  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subdepartment Subdepartment @relation(fields: [subdepartmentId], references: [id], onDelete: Cascade)

  @@unique([subdepartmentId, permissionId], name: "unique_subdepartment_permission")
  @@index([orgId, subdepartmentId])
  @@index([subdepartmentId])
  @@index([permissionId])
}

// Permissões por departamento (Matriz de Permissões RBAC)
model DepartmentPermission {
  id           String   @id @default(uuid())
  orgId        String
  departmentId String
  permissionId String // Referência à permissão
  granted      Boolean  @default(true) // true = permitido, false = negado explícito
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, permissionId], name: "unique_department_permission")
  @@index([orgId, departmentId])
  @@index([departmentId])
  @@index([permissionId])
}

// Auditoria de mudanças de permissões
model PermissionAuditLog {
  id            String   @id @default(uuid())
  orgId         String
  entityType    String // "position" | "sector" | "subdepartment" | "department" | "user"
  entityId      String // ID do cargo, setor, subdepartamento, departamento ou usuário
  permissionId  String // ID ou chave da permissão (ex: "products:view")
  action        String // "granted" | "denied" | "removed"
  granted       Boolean? // true = concedido, false = negado, null = removido
  previousValue Boolean? // Valor anterior (para rastreamento)
  actorId       String // ID do usuário que fez a mudança
  reason        String?  @db.VarChar(512) // Motivo da mudança (opcional)
  metadata      Json? // Dados adicionais flexíveis
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, entityType, entityId])
  @@index([orgId, entityType])
  @@index([orgId, createdAt])
  @@index([entityId])
  @@index([permissionId])
  @@index([actorId])
}

// Workflow de aprovação para mudanças sensíveis de RBAC
model PermissionChangeRequest {
  id    String @id @default(uuid())
  orgId String

  // target
  entityType   String // "position" | "sector" | "subdepartment" | "department" | "user"
  entityId     String
  permissionId String
  granted      Boolean? // true = grant, false = deny, null = remove (futuro)

  // request
  reason      String? @db.VarChar(512)
  status      String  @default("pending") // pending | approved | rejected | cancelled
  requestedBy String

  // decision
  decidedBy      String?
  decidedAt      DateTime?
  decisionReason String?   @db.VarChar(512)

  // SLA
  slaDueAt      DateTime?
  slaNotifiedAt DateTime?
  slaBreachedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([orgId, entityType, entityId])
  @@index([permissionId])
  @@index([requestedBy])
}

// Permissões customizadas por usuário (última camada do RBAC)
model UserPermission {
  id           String   @id @default(uuid())
  orgId        String
  userId       String
  permissionId String
  granted      Boolean  @default(true)
  reason       String?  @db.VarChar(512)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String
  updatedBy    String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, permissionId], name: "unique_user_permission")
  @@index([orgId, userId])
  @@index([permissionId])
}

