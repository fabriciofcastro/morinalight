// ============================================
// PRÉ-FICHA TÉCNICA (MOLDES LIBERADOS)
// ============================================

model PreFichaTecnica {
  id               String @id @default(uuid())
  orgId            String
  numeroSequencial Int    @unique // ID sequencial imutável

  // Identificação Geral
  codigoPeca     String                @db.VarChar(100)
  nomePecaPiloto String                @db.VarChar(255)
  categoria      String?               @db.VarChar(100)
  versaoMolde    Int                   @default(1)
  status         PreFichaTecnicaStatus @default(rascunho)

  // Evidências Visuais
  fotoPecaUrl        String? @db.VarChar(512)
  fotoPecaStorageKey String? @db.VarChar(512)
  fotosAdicionais    Json? // Array de URLs/storage keys

  // Responsáveis Técnicos (imutáveis após liberação)
  estilistaId     String? // User ID
  estilistaNome   String? @db.VarChar(255)
  modelistaId     String? // User ID
  modelistaNome   String? @db.VarChar(255)
  piloteiroId     String? // User ID
  piloteiroNome   String? @db.VarChar(255)
  liberadoPorId   String? // User ID (perfil autorizado)
  liberadoPorNome String? @db.VarChar(255)

  // Grade de Tamanhos
  gradeTamanhos Json? // Array: ["PP", "P", "M", "G", "GG"]

  // Observações
  observacoesTecnicas String? @db.Text
  observacoesOficina  String? @db.VarChar(1000)

  // Alteração Técnica
  houveAlteracao     Boolean @default(false)
  descricaoAlteracao String? @db.VarChar(500)

  // Checklist Técnico (JSON)
  checklistTecnico Json? // { moldeVesteCorretamente: boolean, costuraViavel: boolean, ... }

  // Medidas Críticas
  medidasCriticas String? @db.Text

  // Conclusão da Avaliação
  resultadoAvaliacao  String? @db.VarChar(50) // "APROVADA" | "REPROVADA"
  observacaoAvaliacao String? @db.VarChar(1000)

  // Datas importantes
  dataSubmissao           DateTime?
  dataInicioRevisao       DateTime?
  dataAprovacaoTecnica    DateTime?
  dataAprovacaoDiretoria  DateTime?
  dataReprovacao          DateTime?
  justificativaReprovacao String?   @db.Text

  // Versionamento
  versaoAtual      Int     @default(1)
  versaoAnteriorId String? // ID da versão anterior (se houver)

  // Auditoria
  createdBy String
  updatedBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  // Relacionamentos
  organization    Organization                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tecidos         TecidoPreFichaTecnica[]
  insumosTecnicos InsumoTecnicoPreFichaTecnica[]
  versoes         VersaoPreFichaTecnica[]
  auditorias      AuditoriaPreFichaTecnica[]
  fotos           FotoPreFichaTecnica[]

  @@unique([orgId, numeroSequencial])
  @@index([orgId, status])
  @@index([orgId, codigoPeca])
  @@index([orgId, categoria])
  @@index([orgId, createdAt])
  @@index([orgId, deletedAt])
  @@index([versaoAnteriorId])
}

