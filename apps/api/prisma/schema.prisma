  acls            AccessControlList[]
  geoRestrictions RoleGeoRestriction[]

  @@unique([orgId, code])
  @@index([orgId, active])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(100) // CRM_LEAD_VIEW
  name        String   @db.VarChar(150)
  description String?  @db.Text
  module      String   @db.VarChar(50) // CRM, CLM, PCP
  level       String   @db.VarChar(50) // READ, WRITE, ADMIN
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles           RolePermission[]
  userPermissions UserPermission[]
