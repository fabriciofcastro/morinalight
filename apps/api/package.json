{
  "name": "@morina/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "dev": "bash scripts/free-port-auto.sh 3333 && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bash scripts/free-port-auto.sh 3333 && node dist/main.js",
    "lint": "pnpm -w biome check apps/api/src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-user": "tsx src/scripts/create-user.ts",
    "update-password": "tsx scripts/update-user-password.ts",
    "list-users": "tsx scripts/list-users.ts",
    "studio": "bash scripts/run-studio.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.0.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@morina/catalogo-application": "workspace:*",
    "@morina/catalogo-domain": "workspace:*",
    "@morina/shared-kernel": "workspace:*",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "papaparse": "^5.5.3",
    "pino": "^9.3.2",
    "prom-client": "^15.1.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/node": "^20.19.24",
    "@types/papaparse": "^5.5.2",
    "c8": "^10.1.2",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.21.1",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  }
}