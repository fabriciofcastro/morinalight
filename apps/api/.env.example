# Variáveis compartilhadas
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333
LOG_LEVEL=info

# Infra de dados (ajuste conforme ambiente)
DATABASE_URL=postgres://morina:morina@localhost:5432/morina
REDIS_URL=redis://localhost:6379

# Realtime (deve ter pelo menos 16 caracteres)
REALTIME_SECRET=change-me-super-secret-development-12345

# JWT (deve ter pelo menos 32 caracteres)
JWT_SECRET=change-me-jwt-secret-key-at-least-32-chars


# ============================================
# Sentry (Error Tracking & Profiling)
# ============================================
# DSN (API Project)
SENTRY_DSN=https://your-dsn@o0000000.ingest.sentry.io/1111111

# Enable/Disable Sentry
SENTRY_ENABLED=true

# Application Version (Sync with package.json)
APP_VERSION=0.1.0

# Sampling Rates (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
