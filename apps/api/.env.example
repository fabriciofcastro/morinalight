# Core Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/morina
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_KEY
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Security Alerts (Optional but Recommended)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_FROM=security@morina.ai
ALERT_EMAIL_TO=admin@morina.ai
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Geolocation (Optional but Recommended)
GEOIP_DB_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# SIEM Integration (Optional)
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=morina-audit

# WebAuthn (Optional)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Machine Learning (Optional)
ML_ENABLED=true
ML_TRAINING_SCHEDULE=0 2 * * *
ML_MIN_TRAINING_SAMPLES=1000

# Fail2Ban
FAIL2BAN_LOG_PATH=/var/log/morina/auth-failures.log
