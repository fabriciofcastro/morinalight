{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "vitest/globals"
    ],
    "baseUrl": ".",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@morina/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@morina/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@morina/realtime-client": [
        "../../packages/realtime-client/src/index.ts"
      ],
      "@morina/realtime-client/*": [
        "../../packages/realtime-client/src/*"
      ],
      "@morina/shared-kernel": [
        "../../packages/shared-kernel/src/index.ts"
      ],
      "@morina/shared-kernel/*": [
        "../../packages/shared-kernel/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}