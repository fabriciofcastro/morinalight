const MOCK_COMPANY = {
  id: "1",
  name: "Morina Tecnologia",
  legalName: "Morina Soluções em Tecnologia Ltda",
  cnpj: "12.345.678/0001-90",
  email: "contato@morina.com.br",
  financialEmail: "financeiro@morina.com.br",
  phone: "(11) 99999-8888",
  secondaryPhone: "(11) 3333-4444",
  whatsapp: "(11) 98888-7777",
  website: "https://morina.com.br",
  companySize: "EPP",
  foundedAt: "2020-01-15",

  address: {
    street: "Av. Paulista",
    number: "1000",
    complement: "Conj 101",
    neighborhood: "Bela Vista",
    city: "São Paulo",
    state: "SP",
    zipCode: "01310-100",
    country: "Brasil",
  },

  fiscal: {
    taxRegime: "SIMPLES",
    icmsRate: 18,
    issRate: 5,
    pisRate: 1.65,
    cofinsRate: 7.6,
    nfeEnvironment: "HOMOLOGACAO",
