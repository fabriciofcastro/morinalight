# Test Environment Variables
# Copy this file to .env.test and fill in the values

# Node Environment
NODE_ENV=test

# Database Configuration
POSTGRES_USER=morina
POSTGRES_PASSWORD=morina_test
POSTGRES_DB=morina_test
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=replicator_test

# Redis Configuration
REDIS_PASSWORD=redis_test

# JWT Secret (minimum 32 characters)
JWT_SECRET=test-jwt-secret-test-jwt-secret-12345

# Realtime Secret (minimum 16 characters)
REALTIME_SECRET=test-realtime-secret

# API Configuration
API_PORT=3333
API_HOST=0.0.0.0
LOG_LEVEL=debug

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3334
