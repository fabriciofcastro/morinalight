# MORINA - Produção (exemplo)
# Copie para .env.production e troque TODOS os valores.
# IMPORTANTE: não deixe "CHANGE_ME" em produção.

# Database
POSTGRES_USER=morina
POSTGRES_DB=morina
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_STRONG_REPLICATION_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Auth / Secrets
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
REALTIME_SECRET=CHANGE_ME_REALTIME_SECRET_MIN_16_CHARS

# Logs
LOG_LEVEL=info

# URLs públicas (usadas no build do Next dentro do docker-compose.prod.yml)
# Em VPS com Nginx do compose, normalmente fica assim:
NEXT_PUBLIC_API_URL=http://nginx:80/api
NEXT_PUBLIC_REALTIME_URL=ws://nginx:80/realtime
