# Production Environment Variables
# Copy this file to .env.production and fill in the values

# Node Environment
NODE_ENV=production

# Database Configuration
POSTGRES_USER=morina
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=morina
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_REPLICATION_PASSWORD

# Redis Configuration
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT Secret (minimum 32 characters)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MINIMUM_32_CHARACTERS_LONG

# Realtime Secret (minimum 16 characters)
REALTIME_SECRET=CHANGE_ME_REALTIME_SECRET_MINIMUM_16_CHARACTERS

# API Configuration
API_PORT=3333
API_HOST=0.0.0.0
LOG_LEVEL=info

# Frontend URLs (adjust to your domain)
NEXT_PUBLIC_API_URL=https://api.morina.local
NEXT_PUBLIC_REALTIME_URL=wss://realtime.morina.local
