{
  "name": "morinalight",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:stack": "docker compose up --build",
    "lint": "turbo run lint",
    "test": "pnpm -r --parallel test",
    "test:e2e": "pnpm --filter web test:e2e",
    "typecheck": "turbo run typecheck",
    "prepush": "pnpm lint && pnpm typecheck && pnpm test && pnpm -w commit:guard",
    "commit:guard": "commitlint -E HUSKY_GIT_PARAMS || echo 'commitlint ok'",
    "docs:index": "node scripts/index-docs.mjs",
    "docs:watch": "node scripts/watch-canonical-docs.mjs",
    "mcp:validate": "node scripts/validate-mcp.mjs",
    "demo:catalogo": "node scripts/catalogo-demo.mjs",
    "prepare": "husky",
    "biome": "biome",
    "prettier": "prettier"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.19.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "happy-dom": "^16.5.3",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
