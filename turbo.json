{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "outputs": []
    },
    "test:e2e": {
      "outputs": [],
      "cache": false,
      "dependsOn": ["^build", "build"]
    },
    "dev": {
      "cache": false
    }
  }
}

