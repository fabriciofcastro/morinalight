# Configurações para desenvolvimento local
# Para produção, use valores seguros e únicos!

REALTIME_SECRET=dev_realtime_secret_change_me_in_production
REALTIME_PENDING_ALERT_THRESHOLD=100
REALTIME_PENDING_ALERT_INTERVAL_MS=30000

# Database (local: docker-compose sobe em localhost:5432)
DATABASE_URL=postgresql://morina:morina@localhost:5432/morina

# Redis (local: docker-compose sobe em localhost:6379 sem senha)
REDIS_URL=redis://localhost:6379

# JWT Secret (mínimo 32 caracteres)
JWT_SECRET=dev-jwt-secret-key-change-me-in-production-min-32-chars

# URLs públicas (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3334
NEXT_PUBLIC_ORG_ID=org-demo
NEXT_PUBLIC_ACTOR_ID=user-demo

# ========================================
# SECURITY CONFIGURATION
# ========================================

# Encryption Keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=dev-encryption-key-change-me-in-production-min-64-chars
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ENCRYPTION_SALT=dev-encryption-salt-change-me-in-production-min-128-chars

# Multi-Factor Authentication
MFA_APP_NAME=MorinaLight

# Intrusion Detection System
IDS_ENABLED=true
IDS_BLOCK_DURATION_MINUTES=30
IDS_MAX_FAILED_LOGINS=5

# Rate Limiting (Optional - for Redis-based rate limiting in production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
