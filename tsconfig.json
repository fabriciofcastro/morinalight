{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@morina/ui": [
        "packages/ui/src/index.ts"
      ],
      "@morina/ui/*": [
        "packages/ui/src/*"
      ],
      "@morina/catalogo-domain": [
        "packages/catalogo-domain/src/index.ts"
      ],
      "@morina/catalogo-domain/*": [
        "packages/catalogo-domain/src/*"
      ],
      "@morina/catalogo-application": [
        "packages/catalogo-application/src/index.ts"
      ],
      "@morina/catalogo-application/*": [
        "packages/catalogo-application/src/*"
      ],
      "@morina/preficha-domain": [
        "packages/preficha-domain/src/index.ts"
      ],
      "@morina/preficha-domain/*": [
        "packages/preficha-domain/src/*"
      ],
      "@morina/preficha-application": [
        "packages/preficha-application/src/index.ts"
      ],
      "@morina/preficha-application/*": [
        "packages/preficha-application/src/*"
      ],
      "@morina/shared-kernel": [
        "packages/shared-kernel/src/index.ts"
      ],
      "@morina/shared-kernel/*": [
        "packages/shared-kernel/src/*"
      ],
      "@morina/realtime-client": [
        "packages/realtime-client/src/index.ts"
      ],
      "@morina/realtime-client/*": [
        "packages/realtime-client/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "apps",
    "packages",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    ".turbo",
    "dist",
    "build"
  ]
}
