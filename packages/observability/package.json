{
  "name": "@morina/observability",
  "version": "0.0.1",
  "description": "Shared observability utilities for MorinaLight",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sentry",
    "observability",
    "monitoring"
  ],
  "author": "Fabricio Castro",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.19.24",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3",
    "@biomejs/biome": "^2.3.4"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.2",
    "@sentry/node": "^10.32.1",
    "zod": "^3.23.8"
  }
}