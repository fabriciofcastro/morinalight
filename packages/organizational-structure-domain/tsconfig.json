{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": ".",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": false,
        "declaration": true,
        "composite": true,
        "esModuleInterop": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}